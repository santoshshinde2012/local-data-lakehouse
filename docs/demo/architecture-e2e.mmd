%% Source of architecture-e2e.png. Regenerate (mermaid-cli):
%%   npx -y @mermaid-js/mermaid-cli -i docs/demo/architecture-e2e.mmd -o docs/demo/architecture-e2e.png -s 3 -w 1600 -b white
flowchart LR
  HOST["Host · light profile (no JVM)<br/>DuckDB 1.5.6 · PyIceberg 0.12.0<br/>Polars 1.44.2"]

  subgraph STACK["docker compose · ldl-net"]
    direction TB
    INIT["lakehouse-init<br/>bucket · warehouse · namespaces"]
    LK["Lakekeeper v0.13.6<br/>Iceberg REST catalog :8181<br/>vended S3 credentials"]
    PG[("Postgres 18.6<br/>catalog state")]
    OS[("RustFS 1.0.0 (default)<br/>or SILO overlay (STORE=silo)<br/>s3://lake/warehouse :9000")]
    SP["Spark 4.1.3 + Iceberg 1.12.0<br/>full profile<br/>bronze → silver → gold"]
    TR["Trino 483<br/>optional (TRINO=1)"]
  end

  subgraph AIR["Airflow 3.3.2 overlay (optional)"]
    direction TB
    DAGS["DAGs: lakehouse_retail_medallion<br/>lakehouse_churn_features<br/>lakehouse_graph"]
    PX["socket proxy<br/>docker exec ldl-spark / ldl-graph only"]
  end

  subgraph GRAPH["Graph layer · ldl-graph (no credentials)"]
    direction TB
    GB["graph build from Iceberg tag<br/>PyIceberg REST reader"]
    GC{"strict PIT contract<br/>+ lineage contract"}
    LB[("Parquet + LadybugDB<br/>graph.lbdb")]
    MCP["read-only MCP tools<br/>graph · metrics · lineage · cohorts"]
  end

  EXP[["data/export<br/>churn_user_features.csv<br/>churn_renewals_audit.csv<br/>hero_inference_record.json"]]

  subgraph RADAR["retention-radar (separate repo)"]
    direction TB
    RS["sync + ingest<br/>CHURN_DATA_SOURCE=lakehouse"]
    RB["batch score<br/>XGBoost / LightGBM bundle"]
    RO["scores.csv · next-best action"]
  end

  INIT -.-> OS
  INIT -.-> LK
  LK --> PG
  SP & TR -->|REST| LK
  HOST -->|REST + vended creds| LK
  SP & TR --> OS
  HOST -->|Parquet + metadata| OS
  DAGS --> PX
  PX -.->|spark-submit| SP
  PX -.->|graph build| GB
  SP -->|gold.graph_* + tag| GB
  GB --> LB --> GC --> MCP
  SP -->|04_export_features| EXP
  EXP --> RS --> RB --> RO

  classDef core fill:#fdebd0,stroke:#333;
  classDef store fill:#d6eaf8,stroke:#333;
  classDef opt fill:#f5f5f5,stroke:#666,stroke-dasharray: 5 5;
  classDef ext fill:#e8f8f5,stroke:#333;
  class LK core
  class HOST ext
  class OS,PG,LB store
  class TR,DAGS,PX opt
  class RS,RB,RO,EXP ext

# Sample-only credentials for local learning. Never use these in production.

# Silo object store (S3-compatible; MinIO_* env names are the SILO contract)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Postgres (Iceberg JDBC catalog)
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=iceberg
POSTGRES_DB=iceberg
POSTGRES_PORT=5432

# Iceberg / Spark
WAREHOUSE=s3a://lake/warehouse
BUCKET=lake
SPARK_UI_PORT=4040

# Apache Airflow (orchestration overlay)
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
LDL_SPARK_CONTAINER=ldl-spark

# =============================================================================
# Local-only settings for docker compose (copy to .env: `make env` or cp .env.example .env).
# These sample secrets are for a closed laptop demo; change them before sharing a machine.
# .env is gitignored. Compose refuses to start when a required value is missing.
# =============================================================================

# --- Object store (RustFS by default; SILO with STORE=silo / docker-compose.silo.yml) ---
S3_ACCESS_KEY=lakehouse-admin
S3_SECRET_KEY=lakehouse-local-only-secret
S3_BUCKET=lake
S3_REGION=us-east-1
# Published as S3_API_PORT:S3_API_PORT (same port inside and outside: see docs/object-store.md)
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
# What Lakekeeper vends to every engine. objectstore.localhost = network alias inside ldl-net,
# loopback on the host. Keep the port equal to S3_API_PORT.
S3_ENDPOINT=http://objectstore.localhost:9000

# --- Catalog: Lakekeeper (Iceberg REST) on Postgres 18 ---
LAKEKEEPER_PORT=8181
LAKEKEEPER_WAREHOUSE=lakehouse
# Encrypts the S3 credential Lakekeeper stores in Postgres (any long random string).
LAKEKEEPER_ENCRYPTION_KEY=local-only-change-me-0123456789abcdef
LAKEKEEPER_LOG=info
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=lakekeeper-local-only
POSTGRES_DB=lakekeeper

# --- Engines (full profile) ---
SPARK_UI_PORT=4040
TRINO_PORT=8088

# --- Airflow 3 overlay (make airflow-up fills the empty secrets with random values) ---
AIRFLOW_API_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_DB_PASSWORD=
# Linux only (written by pipelines/airflow_env.sh): run Airflow as your uid so bind mounts stay yours.
# AIRFLOW_UID=1000
LDL_SPARK_CONTAINER=ldl-spark
LDL_GRAPH_CONTAINER=ldl-graph
